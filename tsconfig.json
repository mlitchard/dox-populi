{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "machine": ["harness/machine"],
      "role.harvester": ["harness/role.harvester"],
      "role.upgrader": ["harness/role.upgrader"],
      "role.builder": ["harness/role.builder"],
      "role.defender": ["harness/role.defender"]
    }
  },
  "include": [
    "harness/**/*.ts",
    "generated/**/*.ts",
    "vendor/screeps.d.ts"
  ]
}
