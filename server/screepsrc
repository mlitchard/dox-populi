; dox-populi private server config — TEMPLATE.
; `nix run .#server` regenerates .server-data/.screepsrc from this file on
; every launch, injecting the Steam Web API key decrypted from
; secrets/steam-api-key. Edit THIS file (versioned), not the generated copy.
;
; Launched standalone (no Steam client), so a Steam Web API key is required
; for authenticating users via Steam. Obtain one at:
;   http://steamcommunity.com/dev/apikey
; then: echo -n 'KEY' | nix run .#secrix encrypt ./secrets/steam-api-key -- --all-users
steam_api_key =

; Game server listen address/port.
port = 21025
host = 127.0.0.1

; Server password required on user sign in (empty = no password).
password =

; CLI socket (screeps CLI / repl). Defaults to port+1.
cli_port = 21026
cli_host = 127.0.0.1

; Player runner worker processes. >1 means multiple simultaneous global
; environments per player — not recommended for a basic setup.
runners_cnt = 1
; Parallel runner threads for player scripts. Keep <= physical CPU cores.
runner_threads = 4
; Room processor workers. Keep <= physical CPU cores.
processors_cnt = 2

; Paths are relative to the server data dir (.server-data/).
; assets and node_modules are symlinks into the Steam install.
logdir = logs
modfile = mods.json
assetdir = assets
db = db.json

; Forward console messages to terminal.
log_console = true
log_rotate_keep = 5

; Keep built-in storage enabled (no external mongo/lokijs replacement).
storage_disabled = false

; Automatically restart child processes (seconds).
restart_interval = 3600
